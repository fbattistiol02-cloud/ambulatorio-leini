{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ambulatorio-leini",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "ambulatorioveterinarioleini.it", "custom_domain": true },
    { "pattern": "www.ambulatorioveterinarioleini.it", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
